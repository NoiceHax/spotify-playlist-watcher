# Copy to .env and fill in. NEVER commit real secrets.
# Spotify app: https://developer.spotify.com/dashboard -> app -> Settings
# Redirect URI for the token helper: http://127.0.0.1:8888/callback

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Playlist to compare against Liked Songs (exact name, case-insensitive).
PLAYLIST_NAME=Chimichungus

# Optional: Discord channel webhook for new-difference alerts.
# Without it, diffs are only logged + stored in SQLite.
DISCORD_WEBHOOK_URL=

# Seconds between polls (min 60). Liked Songs change slowly; 1800 = 30 min.
POLL_INTERVAL_SECONDS=1800

# Path inside the container. Keep as-is for Docker; override only for local runs.
DB_PATH=/app/data/watcher.db

# Read-only comparison by default. Set to true to auto-add Liked Songs that
# are missing from the playlist (requires playlist-modify scopes on the token).
SYNC_ADD_MISSING=false

LOG_LEVEL=INFO

# With SYNC_ADD_MISSING: rock = only add rock/metal, none = add everything.
GENRE_FILTER=rock
